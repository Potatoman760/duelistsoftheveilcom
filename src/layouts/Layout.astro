---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { copy } from '../data/copy';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.name ? site.name : `${title} — ${site.shortName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#110c1d" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#main" class="skip">{copy.ui.skipToContent}</a>
    <Header path={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--gold);
    color: var(--ink);
    border: 3px solid var(--ink);
    padding: 12px 18px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .skip:focus { left: 12px; top: 12px; }
</style>
