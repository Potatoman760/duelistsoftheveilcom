---
import { Image } from 'astro:assets';
import { copy } from '../data/copy';
import { keepers } from '../data/cast';
import { factionById } from '../data/factions';
import Sigil from './Sigil.astro';
---

<section class="keepers vellum grain">
  <div class="shell inner">
    <header class="section-head">
      <span class="kicker violet">{copy.keepersSection.kicker}</span>
      <h2 class="h2">{copy.keepersSection.heading}</h2>
      <p class="lede">{copy.keepersSection.lede}</p>
    </header>

    <ol class="ladder">
      {
        keepers.map((k) => (
          <li class="keeper ink-box-sm">
            <div class="art">
              <Image src={k.portrait} alt="" widths={[220, 440]} sizes="(max-width: 900px) 200px, 190px" />
              <span class="ring">
                <span class="ring-label">{copy.keepersSection.ringLabel}</span>
                {k.ring}
              </span>
            </div>
            <div class="text">
              <h3 class="name">{k.name}</h3>
              <span class="district">{k.district}</span>
              <span class="shop">{k.shop}</span>
              <p class="blurb">{k.blurb}</p>
              <span class="deck">
                {k.deck.map((f) => (
                  <span class="chip" title={factionById[f].name}>
                    <Sigil faction={f} size={15} weight={2.4} labelled />
                  </span>
                ))}
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .keepers { padding-block: 92px 100px; }
  .inner { position: relative; display: flex; flex-direction: column; gap: 48px; }

  .ladder {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .keeper { display: flex; flex-direction: column; background: var(--vellum-hi); }

  .art {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 35%, var(--night-4), var(--night) 75%);
    border-bottom: 2px solid var(--ink);
  }
  .art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 8%; }

  .ring {
    position: absolute;
    left: 8px;
    top: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 42px;
    padding: 4px 6px 5px;
    background: var(--gold);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 22px;
    line-height: 1;
  }
  .ring-label { font-family: var(--font-body); font-size: 9px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 2px; }

  .text { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 3px; flex: 1; }
  .name { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 19px; line-height: 1.15; }
  .district { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--veil-deep); }
  .shop { font-size: 13px; color: var(--ink-3); }
  .blurb { margin: 8px 0 10px; font-size: 14px; line-height: 1.5; color: var(--ink-2); }

  .deck { margin-top: auto; display: flex; gap: 6px; }
  .chip {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--night);
  }

  @media (max-width: 1100px) {
    .ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .art { aspect-ratio: 4 / 4; }
  }

  /* a swipeable rail on a phone, in ring order */
  @media (max-width: 900px) {
    .keepers { padding-block: 48px 52px; }
    .inner { gap: 24px; }
    .ladder {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 12px;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .ladder::-webkit-scrollbar { display: none; }
    .keeper { flex: 0 0 210px; scroll-snap-align: start; }
    .art { aspect-ratio: 3 / 4; }
  }
</style>
