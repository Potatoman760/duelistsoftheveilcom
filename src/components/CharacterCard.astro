---
import { Image } from 'astro:assets';
import type { Character } from '../data/cast';

interface Props {
  member: Character;
}
const { member } = Astro.props;
const [top, bottom] = member.tint;
---

<button
  type="button"
  class="card ink-box-sm char-card"
  data-lb-open={member.id}
  style={`background: linear-gradient(163deg, ${top}, ${bottom})`}
>
  <Image src={member.portrait} alt="" widths={[220, 440]} sizes="(max-width: 900px) 168px, 190px" class="portrait" />
  <span class="cap">
    <span class="name">{member.name}</span>
    <span class="role">{member.role}</span>
  </span>
</button>

<style>
  /* screen texture over the tint, beneath the cut-out portrait */
  .char-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: .12;
    background-image: radial-gradient(var(--mist-hi) 1.1px, transparent 1.2px);
    background-size: 6px 6px;
  }

  .char-card {
    /* the portrait art is drawn at 2:3 */
    aspect-ratio: 2 / 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
  }

  .portrait {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .cap {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 34px 14px 14px;
    background: linear-gradient(to top, rgb(17 12 29 / .96) 58%, rgb(17 12 29 / 0));
  }

  .name { font-family: var(--font-display); font-weight: 800; font-size: 17px; line-height: 1.15; color: var(--mist-hi); }
  .role { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); }

  @media (max-width: 900px) {
    .cap { padding: 28px 11px 12px; }
    .name { font-size: 15px; }
    .role { font-size: 11px; }
  }
</style>
