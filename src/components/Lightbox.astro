---
import { Image } from 'astro:assets';
import { characters } from '../data/cast';
import { screenshots } from '../data/screenshots';
import { copy } from '../data/copy';

/**
 * Every panel is rendered server-side and hidden; a card just names the one to
 * reveal. No payload in data attributes, and it degrades to nothing without JS
 * (the cards simply do not open). Arrows step through whichever group the open
 * panel belongs to.
 */
---

<dialog class="lb" data-lightbox aria-label={copy.ui.lightbox.dialogLabel}>
  <button type="button" class="lb-close" data-lb-close aria-label={copy.ui.lightbox.close}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19"></path>
    </svg>
  </button>

  <div class="lb-stage">
    <div class="lb-content" data-lb-content>
      <div class="lb-nav" data-lb-nav hidden>
        <button type="button" class="lb-arrow" data-lb-prev aria-label={copy.ui.carousel.prev}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m14 5-7 7 7 7"></path>
          </svg>
        </button>
        <span class="lb-count" data-lb-count aria-live="polite" aria-atomic="true"></span>
        <button type="button" class="lb-arrow" data-lb-next aria-label={copy.ui.carousel.next}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m10 5 7 7-7 7"></path>
          </svg>
        </button>
      </div>

      {
        screenshots.map((shot, i) => (
          <figure class="panel shot-panel ink-box" data-lb-panel={`shot-${i}`} data-lb-group="shots" hidden>
            <Image src={shot.image} alt={shot.alt} widths={[960, 1440, 1920]} sizes="min(1120px, 92vw)" />
            <figcaption>
              <span class="p-title">{shot.title}</span>
              <span class="p-meta">{shot.mode}</span>
            </figcaption>
          </figure>
        ))
      }

      {
        characters.map((member) => (
          <div class="panel char-panel ink-box" data-lb-panel={member.id} data-lb-group="characters" hidden>
            <div class="char-art" style={`background: linear-gradient(163deg, ${member.tint[0]}, ${member.tint[1]})`}>
              <Image src={member.portrait} alt="" widths={[320, 640]} sizes="320px" class="char-photo" />
            </div>
            <div class="char-text">
              <span class="kicker violet">{member.side}</span>
              <h2 class="p-name">{member.name}</h2>
              <span class="p-meta">{member.role}</span>
              <p class="p-blurb">{member.blurb}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</dialog>

<style>
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 96px 88px 48px;
    border: 0;
    background: transparent;
    overflow: auto;
  }
  .lb::backdrop { background: rgb(8 5 14 / .92); }

  .lb-stage { min-height: 100%; display: flex; align-items: center; justify-content: center; }

  .lb-close {
    position: fixed;
    top: 24px;
    right: 28px;
    z-index: 3;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--vellum);
    color: var(--ink);
    border: 3px solid var(--ink);
    cursor: pointer;
    box-shadow: 4px 5px 0 var(--ink);
  }

  .panel[hidden],
  .lb-nav[hidden] { display: none; }

  .lb-content { position: relative; width: 100%; max-width: 1120px; }
  .lb-content.narrow { max-width: 820px; }

  .lb-nav { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: auto;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: 3px solid var(--ink);
    background: var(--vellum);
    color: var(--ink);
    box-shadow: 4px 5px 0 var(--ink);
    cursor: pointer;
  }
  .lb-arrow:hover { background: var(--gold); }
  [data-lb-prev] { left: -70px; }
  [data-lb-next] { right: -70px; }
  .lb-count {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    color: var(--mist);
    font-size: 14px;
    white-space: nowrap;
  }

  /* --- screenshot panel --- */

  .shot-panel { margin: 0; width: 100%; background: var(--night); }
  .shot-panel :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .shot-panel figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--vellum);
    border-top: 3px solid var(--ink);
    padding: 16px 22px;
  }

  /* --- character panel --- */

  .char-panel { display: flex; width: 100%; background: var(--vellum); }

  .char-art {
    position: relative;
    overflow: hidden;
    flex: 0 0 300px;
    width: 300px;
    aspect-ratio: 2 / 3;
    border-right: 3px solid var(--ink);
  }
  .char-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }

  .char-text {
    flex: 1;
    padding: 40px 40px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    color: var(--ink);
  }

  .p-name { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 4vw, 42px); line-height: 1.05; }
  .p-title { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--ink); }
  .p-meta { font-size: 12.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .p-blurb { margin: 0; font-size: 18px; line-height: 1.65; color: var(--ink-2); text-wrap: pretty; }

  @media (max-width: 900px) {
    .lb { padding: 84px 50px 16px; }
    .lb-arrow { width: 36px; height: 44px; }
    [data-lb-prev] { left: -44px; }
    [data-lb-next] { right: -44px; }
    .lb-close { top: 14px; right: 16px; width: 48px; height: 48px; }
    .char-panel { flex-direction: column; }
    .char-art { flex: none; width: 100%; aspect-ratio: 4 / 5; border-right: 0; border-bottom: 3px solid var(--ink); }
    .char-text { padding: 24px 20px 28px; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialog) {
    const panels = Array.from(dialog.querySelectorAll<HTMLElement>('[data-lb-panel]'));
    const nav = dialog.querySelector<HTMLElement>('[data-lb-nav]');
    const content = dialog.querySelector<HTMLElement>('[data-lb-content]');
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]');
    let group: HTMLElement[] = [];
    let index = -1;

    const show = (id: string) => {
      const target = panels.find((panel) => panel.dataset.lbPanel === id);
      if (!target) return;
      panels.forEach((panel) => (panel.hidden = panel !== target));
      group = panels.filter((panel) => panel.dataset.lbGroup === target.dataset.lbGroup);
      index = group.indexOf(target);
      content?.classList.toggle('narrow', target.dataset.lbGroup === 'characters');
      if (nav) nav.hidden = group.length < 2;
      if (count) count.textContent = `${index + 1} / ${group.length}`;
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
    };

    const hideAll = () => {
      panels.forEach((panel) => (panel.hidden = true));
      group = [];
      index = -1;
    };

    const step = (direction: number) => {
      if (!dialog.open || group.length < 2) return;
      const id = group[(index + direction + group.length) % group.length].dataset.lbPanel;
      if (id) show(id);
    };
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
    dialog.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      step(event.key === 'ArrowLeft' ? -1 : 1);
    });

    /** Hide panels in the close path itself rather than relying on the `close`
     *  event, which only covers the ESC route below. */
    const close = () => {
      dialog.close();
      hideAll();
    };

    document.querySelectorAll<HTMLElement>('[data-lb-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.lbOpen;
        if (id) show(id);
      });
    });

    dialog.querySelector('[data-lb-close]')?.addEventListener('click', close);

    // clicking the backdrop (anywhere outside a panel) closes
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('[data-lb-panel]') && !target.closest('[data-lb-close]') && !target.closest('[data-lb-nav]')) close();
    });

    // ESC closes without going through the handlers above
    dialog.addEventListener('close', hideAll);
  }
</script>
